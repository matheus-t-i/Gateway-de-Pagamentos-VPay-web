# URL da API Nest (prefixo /api já incluso no path das chamadas do cliente).
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Cloudflare Turnstile — site key do widget no /login.
# Sem esta variável o widget não aparece (dev/CI). Em produção configure a
# mesma propriedade no Cloudflare Dashboard e o TURNSTILE_SECRET_KEY na API.
# Chave de teste (sempre passa): 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
